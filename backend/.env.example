# ARTHA backend — copy to backend/.env and fill in. NEVER commit the real .env.

# MongoDB connection (local dev default)
MONGO_URL=mongodb://localhost:27017
DB_NAME=artha

# Claude access via the Emergent universal LLM key. Optional: when empty, Ask ARTHA,
# exception explanations and category suggestions fall back to deterministic answers.
# The key is used ONLY on the server and is never sent to the client.
EMERGENT_LLM_KEY=

# Razorpay TEST-mode credentials. Optional: when empty a mock adapter is used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
